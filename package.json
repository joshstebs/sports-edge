{
  "name": "sports-edge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI sports betting analyst platform - chat with live data grounding",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "server": "cd server && tsx src/server.ts",
    "client": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "test": "npm run test:frontend && npm run test --prefix server",
    "test:frontend": "node --import tsx --test test/*.test.ts",
    "setup": "npm install && npm install --prefix server"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
