# SportsEdge - AI Betting Analyst Platform
# LLM provider for the chat brain. Set ONE of these:
# (PDF research is from Google Gemini; gemini-flash-latest is fast + cheap)
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Model overrides (optional)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini

# The Odds API (optional - free tier gives h2h/spreads/totals for MLB/NBA/NFL)
# ODDS_API_KEY=
# ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Ports (defaults fine)
# PORT=3100
