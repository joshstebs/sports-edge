# SportsEdge - AI Betting Analyst Platform
# Primary AI: low-cost DeepSeek Flash through OpenCode Zen, high reasoning.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=deepseek-v4.1-flash
# Optional non-free/connected fallbacks:
OPENCODE_GO_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Groq/Gemini are legacy routes used only when no Zen key is configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sports-data keys (same names accepted by High Five)
THE_ODDS_API_KEY=
# Legacy alias remains accepted:
ODDS_API_KEY=
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_API_KEY_2=
SHARPAPI_API_KEY=
STATSHAWK_API_KEY=
API_SPORTS_KEY=

# Ports (defaults fine)
# PORT=3100
# Exact browser origin allowed to make state-changing requests. Production must
# use HTTPS; separate multiple explicitly trusted origins with commas.
APP_ORIGIN=http://localhost:5180

# Authentication is mandatory. Generate secure scrypt records and a session
# secret with: npm run auth:generate --prefix server -- --admin <name> --tester <name>
AUTH_USERS_JSON=
# Optional scrypt password hash for recovering the existing account named admin.
# Preserves AUTH_USERS_JSON, tester credentials, and account identities.
AUTH_ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# Durable state (required on Vercel; local development uses atomic files)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPORTS_EDGE_REDIS_PREFIX=sports-edge

# Protects the daily outcome evaluator invoked by Vercel Cron.
CRON_SECRET=

# Stripe subscription flow (optional until billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5180
