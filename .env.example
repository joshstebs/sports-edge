# SportsEdge - AI Betting Analyst Platform
# LLM provider for the chat brain. Set ONE of these:
# (PDF research is from Google Gemini; gemini-3.5-flash is fast + cheap)
GEMINI_API_KEY=
# OPENAI_API_KEY=

# OpenRouter fallback (recommended): free models like openai/gpt-oss-20b:free
# kick in when Gemini hits its daily free-tier quota (which is shared across
# ALL Gemini models, so model-rotation alone can't save you).
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
#   alt free tool-calling models: nvidia/nemotron-3-ultra-550b-a55b:free, google/gemma-4-31b-it:free

# Model overrides (optional)
# GEMINI_MODEL=gemini-3.5-flash
# OPENAI_MODEL=gpt-4o-mini

# The Odds API (optional - free tier gives h2h/spreads/totals for MLB/NBA/NFL)
# ODDS_API_KEY=
# ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# SPORTSGAMEODDS_API_KEY=
# API_SPORTS_KEY=

# Ports (defaults fine)
# PORT=3100
# Exact browser origin allowed to make state-changing requests. Production must
# use HTTPS; separate multiple explicitly trusted origins with commas.
APP_ORIGIN=http://localhost:5180

# Authentication is mandatory. Generate secure scrypt records and a session
# secret with: npm run auth:generate --prefix server -- --admin <name> --tester <name>
AUTH_USERS_JSON=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# Durable state (required on Vercel; local development uses atomic files)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPORTS_EDGE_REDIS_PREFIX=sports-edge

# Protects the daily outcome evaluator invoked by Vercel Cron.
CRON_SECRET=

# Stripe subscription flow (optional until billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5180
