# SportsEdge server environment
# Free-first AI (aligned with High Five). Groq gpt-oss is the default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_MODEL=nemotron-3-ultra-free
# Optional non-free/connected fallbacks:
OPENCODE_GO_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Gemini is disabled from the normal chain unless explicitly opted in.
SPORTSEDGE_ALLOW_GEMINI_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sports-data keys (same names accepted by High Five)
THE_ODDS_API_KEY=
# Legacy alias remains accepted:
ODDS_API_KEY=
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_API_KEY_2=
SHARPAPI_API_KEY=
STATSHAWK_API_KEY=
API_SPORTS_KEY=

# --- Server ---
PORT=3100
# Optional canonical browser origin for Origin validation, e.g. https://sports-edge.vercel.app
# Exact frontend origin for CSRF validation (HTTPS is required on Vercel).
APP_ORIGIN=http://localhost:5180

# --- Authentication (required) ---
# Generate an admin and a shareable tester account with:
# npm run auth:generate -- --admin <admin-name> --tester <tester-name>
# Copy the generated JSON and secret here. Plaintext passwords are printed once
# to the terminal and are never written into this file or committed.
AUTH_USERS_JSON=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800

# --- Durable prediction + bet-slip storage (required on Vercel) ---
# Create an Upstash Redis integration and copy its REST credentials. Production
# stateful APIs fail with STORAGE_NOT_CONFIGURED instead of writing to /tmp.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SPORTS_EDGE_REDIS_PREFIX=sports-edge

# Vercel Cron automatically sends this as Authorization: Bearer <secret>.
CRON_SECRET=

# --- Stripe billing (optional until subscription access is enabled) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5180

# Optional local-only override. Never point this at Vercel /tmp for production.
# SPORTS_EDGE_DATA_DIR=./data
