# SportsEdge server environment
# At least one LLM key is required for /api/chat to work.
# GEMINI_API_KEY takes precedence when both are set.

# --- LLM provider (OpenAI-compatible) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- The Odds API (optional; classic platform, key passed as ?apiKey= query param) ---
ODDS_API_KEY=

# --- Server ---
PORT=3100
