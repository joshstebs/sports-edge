{
  "name": "sports-edge-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SportsEdge backend - Express + TypeScript, LLM chat grounded in real live sports data via function calling",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "probe": "tsx scripts/probe.ts",
    "eval": "tsx scripts/evaluate.ts",
    "auth:generate": "tsx scripts/generate-auth-users.ts",
    "test:auth": "node --import tsx --test test/auth.test.ts",
    "test:evaluator": "node --import tsx scripts/evaluator.test.ts",
    "test": "node --import tsx --test test/*.test.ts scripts/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "stripe": "^22.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^6.0.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
